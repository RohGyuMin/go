#!/usr/bin/env bash
# AI 협업 시스템 — pre-push 훅
# 코드 변경이 push 될 때, 대응하는 설명 문서가 이번 브랜치에 있는지 확인하고
# 자가검증(퀴즈 통과) 규칙을 상기시킵니다. 강제 차단이 아니라 "속도 조절 장치"입니다.
set -euo pipefail

BASE="$(git merge-base HEAD origin/dev 2>/dev/null || git merge-base HEAD origin/main 2>/dev/null || echo '')"

if [[ -z "$BASE" ]]; then
  # 비교 기준을 못 찾으면 조용히 통과
  exit 0
fi

# 코드 변경(설명 문서/문서 폴더 제외)이 있는지
CODE_CHANGED="$(git diff --name-only "$BASE"..HEAD -- . ':(exclude)docs/explanations/*' ':(exclude)*.md' || true)"
# 이번 브랜치에서 새로 추가/수정된 설명 문서가 있는지
DOC_CHANGED="$(git diff --name-only "$BASE"..HEAD -- 'docs/explanations/*.md' || true)"

if [[ -n "$CODE_CHANGED" && -z "$DOC_CHANGED" ]]; then
  echo ""
  echo "  ┌────────────────────────────────────────────────────────────┐"
  echo "  │  🚦 자가검증 리마인더 (AI 협업 시스템)                        │"
  echo "  ├────────────────────────────────────────────────────────────┤"
  echo "  │  코드는 바뀌었는데 설명 문서(docs/explanations/*)가 없습니다.│"
  echo "  │                                                            │"
  echo "  │  1) Claude Code 에서:  /explain-diff                        │"
  echo "  │  2) 생성된 5문항 퀴즈를 직접 풀기                            │"
  echo "  │  3) 4문항 미만 → 머지 말고 동료 리뷰 요청                    │"
  echo "  │                                                            │"
  echo "  │  이 리마인더를 건너뛰려면:  git push --no-verify            │"
  echo "  └────────────────────────────────────────────────────────────┘"
  echo ""
fi

# 리마인더일 뿐이므로 push 자체는 막지 않습니다.
exit 0
